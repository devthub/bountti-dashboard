{
  "name": "bountti-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Bountti Dashboard is a web application built with Next.js and TypeScript, designed to provide users with an intuitive interface for managing their Bountti accounts, tracking transactions, and accessing various features related to their financial activities. The dashboard offers a seamless user experience, allowing users to easily navigate through their account information, view transaction history, and utilize tools for financial management. With a focus on security and performance, Bountti Dashboard aims to deliver a reliable platform for users to stay on top of their finances and make informed decisions.",
  "keywords": [
    "nextjs",
    "starter",
    "typescript"
  ],
  "license": "MIT",
  "author": "Wendell Encorporado",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "next typegen && tsc --noEmit",
    "build:analyze": "next build && next experimental-analyze",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --fix --type-aware",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "format:ci": "oxfmt --list-different .",
    "postinstall": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tailwindcss/postcss": "^4.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "postcss": "^8.5.14",
    "radix-ui": "^1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.0",
    "@commitlint/config-conventional": "21.0.0",
    "@types/node": "25.6.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "husky": "9.1.7",
    "lint-staged": "17.0.4",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "oxlint-tsgolint": "0.22.1",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@11.1.1"
}
